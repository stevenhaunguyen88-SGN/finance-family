# Family Finance — local environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ── App ──────────────────────────────────────────────────────
# Optional. Defaults to 5000.
# PORT=5000

# Optional. Where the SQLite file lives. Defaults to ./data.db.
# DATA_DB_PATH=./data.db

# Optional. Set these for Turso/libSQL hosted storage.
# When TURSO_DATABASE_URL is set, DATA_DB_PATH is ignored.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED in production. >=16 chars. Generate with:
#   openssl rand -hex 32
# In development a placeholder is used if missing (with a warning).
SESSION_SECRET=

# Bootstraps the first admin account on startup. After the user is created
# in the DB, these env vars are no longer consulted (changing the password
# here will NOT change the stored password — log in and update through the
# DB or a future admin UI).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to "true" if running behind a reverse proxy (nginx, Caddy, Cloudflare,
# Fly.io, etc). Required for `Secure` cookies + correct client IP rate limiting.
# TRUST_PROXY=false
